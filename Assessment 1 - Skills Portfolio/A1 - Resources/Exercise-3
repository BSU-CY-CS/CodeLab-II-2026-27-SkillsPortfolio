# GUI LAYER
# ===========================================================================
class StudentManager:
    COLUMNS = (("name", "Name", 170), ("code", "Student No.", 90),
               ("coursework", "Coursework /60", 110), ("exam", "Exam /100", 80),
               ("percent", "Overall %", 90), ("grade", "Grade", 60))

    def __init__(self, root, path, students):
        self.root = root
        self.path = path
        self.students = students

        root.title("Student Manager")
        root.geometry("920x520")
        root.minsize(760, 400)

        self.buildMenu()
        self.buildTable()
        self.viewAll()

    # Layout 
    def buildMenu(self):
        menu = tk.Frame(self.root, padx=10, pady=10)
        menu.pack(side="left", fill="y")

        tk.Label(menu, text="MENU", font=("Arial", 14, "bold")).pack(pady=(0, 8))
        items = [("1. View all students", self.viewAll),
                 ("2. View individual student", self.viewIndividual),
                 ("3. Highest total score", self.showHighest),
                 ("4. Lowest total score", self.showLowest)]

        for text, command in items:
            tk.Button(menu, text=text, width=24, command=command).pack(pady=3)
        ttk.Separator(menu).pack(fill="x", pady=8)
        tk.Button(menu, text="Quit", width=24, command=self.root.destroy).pack(pady=3)

    def buildTable(self):
        main = tk.Frame(self.root, padx=5, pady=10)
        main.pack(side="left", fill="both", expand=True)

        self.heading = tk.Label(main, text="", font=("Arial", 14, "bold"), anchor="w")
        self.heading.pack(fill="x")

        table_frame = tk.Frame(main)
        table_frame.pack(fill="both", expand=True, pady=5)
        self.tree = ttk.Treeview(table_frame, show="headings", selectmode="browse",
                                 columns=[c[0] for c in self.COLUMNS])
        for key, title, width in self.COLUMNS:
            self.tree.heading(key, text=title)
            self.tree.column(key, width=width, anchor="w" if key == "name" else "center")
        scrollbar = ttk.Scrollbar(table_frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        self.summary = tk.Label(main, text="", font=("Arial", 11), anchor="w")
        self.summary.pack(fill="x")

    # Display helper 
    def showStudents(self, students, heading, summary_text=None):
        """Fill the table with the given students (shared by every menu item)."""
        self.tree.delete(*self.tree.get_children())
        for s in students:
            self.tree.insert("", "end", iid=str(s.code),
                             values=(s.name, s.code, s.coursework_total, s.exam,
                                     f"{s.percentage:.1f}%", s.grade))
        self.heading.config(text=heading)
        self.summary.config(text=summary_text or f"Showing {len(students)} record(s)")

    #  Menu items 1-4 
    def viewAll(self, select_code=None):
        count, average = classSummary(self.students)
        self.showStudents(self.students, "All student records",
                          f"Students in class: {count}     Class average: {average:.1f}%")
        if select_code is not None and self.tree.exists(str(select_code)):
            self.tree.selection_set(str(select_code))
            self.tree.see(str(select_code))

    def viewIndividual(self):
        text = simpledialog.askstring("Find student",
                                      "Enter a student name or number:", parent=self.root)
        if text is None:
            return
        matches = findStudents(self.students, text)
        if not matches:
            messagebox.showinfo("Not found", f"No student matches '{text.strip()}'.")
            return
        self.showStudents(matches, f"Search results for '{text.strip()}'")

    def showExtreme(self, pick, label):
        """Show the student(s) with the highest/lowest total. `pick` is max or min.
        Ties are all shown rather than choosing one arbitrarily."""
        if not self.students:
            messagebox.showinfo("No data", "There are no student records.")
            return
        target = pick(s.total for s in self.students)
        winners = [s for s in self.students if s.total == target]
        self.showStudents(winners, f"{label} total score ({target} / {MAX_TOTAL})")

