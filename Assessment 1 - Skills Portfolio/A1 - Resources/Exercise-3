def main():
    root = tk.Tk()
    path = findDataFile()
    if path is None:
        messagebox.showerror("File not found",
                             f"Could not find {DATA_FILE}.\nPlace it next to this script.")
        root.destroy()
        return

    students, problems = loadStudents(path)
    if problems:
        messagebox.showwarning("Some records were skipped", "\n".join(problems))

    StudentManager(root, path, students)
    root.mainloop()


if __name__ == "__main__":
    main()