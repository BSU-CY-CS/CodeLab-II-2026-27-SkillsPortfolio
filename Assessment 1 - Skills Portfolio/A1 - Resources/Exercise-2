"""
Exercise 2 - Alexa tell me a Joke (Tkinter)

A joke-telling assistant styled like a comedy club. It loads jokes from
randomJokes.txt (one joke per line, setup and punchline separated by a
question mark), shows a setup, then reveals the punchline on request.

Features
  - Shuffled deck: every joke is told once before any joke repeats
  - Joke counter, "thinking" dots, typewriter text and a punchline flash
  - "Spotlight club" theme, rounded hover-zoom buttons, chasing marquee lights
  - Favourites (saved to favourites.txt) and funny / groan ratings
  - Search the jokes, and add your own joke (saved to randomJokes.txt)
  - Keyboard shortcuts: Space (reveal / next), F (favourite), Esc (quit)
"""

import math
import os
import random
import tkinter as tk
from tkinter import filedialog, messagebox

JOKES_FILE = "randomJokes.txt"
FAVOURITES_FILE = "favourites.txt"   # saved favourites live next to this script

# Look next to this script first, then in the course resources folder
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SEARCH_PATHS = [
    os.path.join(SCRIPT_DIR, JOKES_FILE),
    os.path.join(SCRIPT_DIR, "..", "A1 - Resources", JOKES_FILE),
]

#  Theme colours: "Spotlight club"  
CURTAIN = "#4A0F1B"         # window background: burgundy curtain
SPOTLIGHT = "#FFF3D6"       # cream card the joke sits on
SPOTLIGHT_HOVER = "#F6E6BF" # secondary button hover fill
GOLD = "#F2B33D"            # primary buttons and title
GOLD_HOVER = "#F7C24F"      # lighter gold when hovered
GOLD_BORDER = "#D9A441"     # card outline
INK = "#2A1A12"             # main text
PUNCHLINE = "#A3213A"       # punchline red
PUNCHLINE_DARK = "#7A1A2B"  # text on outlined buttons
FLASH = "#D9961A"           # colour the punchline flashes to
MUTED = "#8A6A4F"           # small secondary text
BULB_OFF = "#7A3A22"        # unlit marquee bulb
DISABLED_FILL = "#EADFC4"
DISABLED_TEXT = "#A89878"
FONT = "Helvetica"

#  Animation timings (milliseconds) 
TYPE_MS = 28        # delay between typed letters
THINK_MS = 230      # delay between the "thinking" dots
THINK_FRAMES = 4    # how many dot frames before a joke appears
FLASH_MS = 110      # delay between punchline colour flashes
FLASH_COUNT = 6     # number of flash steps
MARQUEE_SLOW_MS = 450
MARQUEE_FAST_MS = 140  # lights speed up while "thinking"


def findJokesFile():
    """Return the path of the jokes file, or None if it cannot be found."""
    for path in SEARCH_PATHS:
        if os.path.isfile(path):
            return path
    return None


def loadJokes(path):
    """Read the file and return a list of (setup, punchline) tuples.

    Each line is split at the FIRST question mark. The question mark stays
    on the setup so it reads naturally. Blank lines and lines without a
    question mark are skipped.
    """
    jokes = []
    with open(path, encoding="utf-8") as file:
        for line in file:
            line = line.strip()
            if "?" not in line:
                continue
            setup, punchline = line.split("?", 1)
            setup, punchline = setup.strip() + "?", punchline.strip()
            if punchline:
                jokes.append((setup, punchline))
    return jokes


def loadFavourites(path):
    """Load saved favourites; a missing or unreadable file means none yet."""
    if not os.path.isfile(path):
        return []
    try:
        return loadJokes(path)
    except (OSError, UnicodeDecodeError):
        return []


def saveJokes(path, jokes):
    """Write jokes to a file in the same 'setup?punchline' format.
    Writes to a temporary file first, then swaps it in, so a failure part
    way through cannot leave a half-written file."""
    temp_path = path + ".tmp"
    with open(temp_path, "w", encoding="utf-8") as file:
        for setup, punchline in jokes:
            file.write(f"{setup}{punchline}\n")
    os.replace(temp_path, path)


def appendLine(path, line):
    """Add one line to the end of a file, first adding a newline if the
    file does not already end with one (randomJokes.txt does not)."""
    needs_newline = False
    if os.path.getsize(path) > 0:
        with open(path, "rb") as file:
            file.seek(-1, os.SEEK_END)
            needs_newline = file.read(1) not in (b"\n", b"\r")
    with open(path, "a", encoding="utf-8") as file:
        if needs_newline:
            file.write("\n")
        file.write(line + "\n")


def searchJokes(jokes, text):
    """Return the jokes whose setup or punchline contains `text`
    (ignoring case). Blank text returns every joke."""
    text = text.strip().lower()
    if not text:
        return list(jokes)
    return [joke for joke in jokes
            if text in joke[0].lower() or text in joke[1].lower()]


def validateNewJoke(setup, punchline, existing):
    """Check a user-entered joke and return a clean (setup, punchline).
    Raises ValueError with a readable message if it is not acceptable."""
    setup, punchline = setup.strip(), punchline.strip()
    if not setup or not punchline:
        raise ValueError("Enter both a setup and a punchline.")

    body = setup[:-1].strip() if setup.endswith("?") else setup
    if not body:
        raise ValueError("The setup needs some words before the question mark.")
    if "?" in body:
        # The file format splits at the first '?', so only one is allowed
        raise ValueError("The setup can only have one question mark, at the end.")

    setup = body + "?"
    if any(setup.lower() == other[0].lower() for other in existing):
        raise ValueError("That joke is already in the list.")
    return setup, punchline


class JokeDeck:
    """A shuffled deck of jokes. Every joke is dealt once before the deck is
    reshuffled, so nothing repeats until all of them have been told."""

    def __init__(self, jokes):
        if not jokes:
            raise ValueError("A deck needs at least one joke.")
        self.jokes = list(jokes)
        self.position = 0     # how many have been dealt this round
        self._cards = []
        self._last = None
        self._shuffle()

    @property
    def total(self):
        return len(self.jokes)

    def _shuffle(self):
        self._cards = self.jokes[:]
        random.shuffle(self._cards)
        # Cards are dealt from the end. Make sure a new round doesn't open
        # with the joke that closed the previous round.
        if len(self._cards) > 1 and self._cards[-1] == self._last:
            self._cards[0], self._cards[-1] = self._cards[-1], self._cards[0]
        self.position = 0

    def draw(self):
        """Deal the next joke, reshuffling when the deck runs out."""
        if not self._cards:
            self._shuffle()
        self._last = self._cards.pop()
        self.position += 1
        return self._last

    def add(self, joke):
        """Add a new joke and slip it into the cards still to be dealt."""
        self.jokes.append(joke)
        self._cards.insert(random.randint(0, len(self._cards)), joke)


#  Custom widgets 
def makeLabel(parent, text, size, color, bold=False, italic=False, **options):
    """Create a themed label that matches its parent's background."""
    style = " ".join(word for word, on in (("bold", bold), ("italic", italic)) if on) or "normal"
    return tk.Label(parent, text=text, bg=parent.cget("bg"), fg=color,
                    font=(FONT, size, style), **options)


class RoundedButton(tk.Canvas):
    """A pill-shaped button that smoothly zooms in when the mouse hovers.

    Standard Tkinter buttons cannot be rounded or animated, so this draws
    the button on a Canvas. The canvas is a little bigger than the button
    so there is room for it to grow without being clipped.
    """
    ZOOM = 1.08       # how much bigger the button gets on hover
    PRESSED = 0.97    # slight shrink while the mouse button is held down
    EASING = 0.25     # fraction of the remaining distance moved per frame
    FRAME_MS = 16     # about 60 frames per second

    STYLES = {
        "primary": {"fill": GOLD, "hover": GOLD_HOVER,
                    "text": INK, "outline": GOLD_BORDER},
        "secondary": {"fill": SPOTLIGHT, "hover": SPOTLIGHT_HOVER,
                      "text": PUNCHLINE_DARK, "outline": PUNCHLINE},
    }

    def __init__(self, master, text, command, width=200, height=42,
                 radius=21, style="primary", font_px=15):
        pad = int(width * (self.ZOOM - 1) / 2) + 4  # headroom for the zoom
        self._cw = width + 2 * pad
        self._ch = height + 2 * pad
        super().__init__(master, width=self._cw, height=self._ch,
                         bg=master.cget("bg"), highlightthickness=0, bd=0)

        self._text = text
        self._command = command
        self._btn_w, self._btn_h = width, height
        self._radius = radius
        self._font_px = font_px
        self._colors = self.STYLES[style]

        self._state = "normal"
        self._hover = False
        self._pressed = False
        self._scale = 1.0      # current size multiplier
        self._job = None       # id of the pending animation frame

        self.bind("<Enter>", self._onEnter)
        self.bind("<Leave>", self._onLeave)
        self.bind("<ButtonPress-1>", self._onPress)
        self.bind("<ButtonRelease-1>", self._onRelease)
        self._draw()

    def _roundRect(self, x0, y0, x1, y1, r, **options):
        """Draw a rounded rectangle as a polygon whose corners are quarter
        circles (10 points per corner)."""
        r = min(r, (x1 - x0) / 2, (y1 - y0) / 2)
        corners = [(x1 - r, y0 + r, -90), (x1 - r, y1 - r, 0),
                   (x0 + r, y1 - r, 90), (x0 + r, y0 + r, 180)]
        points = []
        for centre_x, centre_y, start_angle in corners:
            for step in range(10):
                angle = math.radians(start_angle + step * 10)
                points.append(centre_x + r * math.cos(angle))
                points.append(centre_y + r * math.sin(angle))
        return self.create_polygon(points, **options)

    def _draw(self):
        self.delete("all")
        s = self._scale
        w, h, r = self._btn_w * s, self._btn_h * s, self._radius * s
        x0, y0 = (self._cw - w) / 2, (self._ch - h) / 2

        if self._state == "disabled":
            fill, outline, text_color = DISABLED_FILL, DISABLED_FILL, DISABLED_TEXT
        else:
            fill = self._colors["hover"] if self._hover else self._colors["fill"]
            outline, text_color = self._colors["outline"], self._colors["text"]

        self._roundRect(x0, y0, x0 + w, y0 + h, r, fill=fill, outline=outline, width=2)
        # Negative font size = pixels, which scales smoothly during the zoom
        self.create_text(self._cw / 2, self._ch / 2, text=self._text, fill=text_color,
                         font=(FONT, -round(self._font_px * s), "bold"))

    def _target(self):
        """The size the button is currently trying to reach."""
        if self._state == "disabled":
            return 1.0
        if self._pressed:
            return self.PRESSED
        return self.ZOOM if self._hover else 1.0

    def _animate(self):
        """Start (or restart) moving towards the target size."""
        if self._job is not None:
            self.after_cancel(self._job)
            self._job = None
        self._step()

    def _step(self):
        """One animation frame: move part of the way to the target (easing)."""
        self._job = None
        try:
            target = self._target()
            difference = target - self._scale
            if abs(difference) < 0.002:
                self._scale = target
                self._draw()
                return
            self._scale += difference * self.EASING
            self._draw()
            self._job = self.after(self.FRAME_MS, self._step)
        except tk.TclError:
            pass  # the widget was destroyed mid-animation

    def _onEnter(self, event):
        self._hover = True
        self.config(cursor="arrow" if self._state == "disabled" else "hand2")
        self._animate()

    def _onLeave(self, event):
        self._hover = False
        self._pressed = False
        self._animate()

    def _onPress(self, event):
        if self._state != "disabled":
            self._pressed = True
            self._animate()

    def _onRelease(self, event):
        if not self._pressed:
            return
        self._pressed = False
        self._animate()
        # Only count it as a click if the mouse is still over the button
        if 0 <= event.x <= self._cw and 0 <= event.y <= self._ch:
            self.invoke()

    def invoke(self):
        """Run the button's command, as if it had been clicked."""
        if self._state != "disabled" and self._command:
            self._command()

    def config(self, **options):
        """Support config(state=...) and config(text=...) like a tk.Button."""
        if "state" in options:
            self._state = options.pop("state")
            self._animate()
        if "text" in options:
            self._text = options.pop("text")
            self._draw()
        if options:
            super().config(**options)

    configure = config

    def destroy(self):
        if self._job is not None:
            try:
                self.after_cancel(self._job)
            except tk.TclError:
                pass
            self._job = None
        super().destroy()


class MarqueeLights(tk.Canvas):
    """A strip of bulbs that appear to chase along it, like a theatre
    marquee. Two bulbs in every three are lit and the dark one moves."""

    def __init__(self, master, width=560, bulbs=22, radius=5):
        super().__init__(master, width=width, height=radius * 2 + 8,
                         bg=master.cget("bg"), highlightthickness=0, bd=0)
        self._bulbs = []
        self._phase = 0
        self._interval = MARQUEE_SLOW_MS
        self._job = None

        gap = width / bulbs
        for index in range(bulbs):
            x, y = gap * (index + 0.5), radius + 4
            self._bulbs.append(self.create_oval(
                x - radius, y - radius, x + radius, y + radius,
                fill=BULB_OFF, outline=""))
        self._tick()

    def _tick(self):
        try:
            for index, bulb in enumerate(self._bulbs):
                lit = (index + self._phase) % 3 != 0
                colour = GOLD if index % 2 == 0 else SPOTLIGHT
                self.itemconfig(bulb, fill=colour if lit else BULB_OFF)
            self._phase = (self._phase + 1) % 3
            self._job = self.after(self._interval, self._tick)
        except tk.TclError:
            pass  # the widget was destroyed

    def setFast(self, fast):
        """Speed the lights up (while 'thinking') or slow them down."""
        self._interval = MARQUEE_FAST_MS if fast else MARQUEE_SLOW_MS

    def destroy(self):
        if self._job is not None:
            try:
                self.after_cancel(self._job)
            except tk.TclError:
                pass
            self._job = None
        super().destroy()


#  Pop-up dialogs (search, favourites, add a joke) 
class JokeListDialog(tk.Toplevel):
    """A pop-up list of jokes. Used for both Search (with a search box) and
    Favourites (with a Remove button).

    on_show(joke)   - called with the chosen joke, then the dialog closes
    on_remove(joke) - optional; may raise ValueError to refuse the removal
    """

    def __init__(self, parent, title, jokes, on_show, on_remove=None, searchable=False):
        super().__init__(parent, bg=SPOTLIGHT)
        self.title(title)
        # open slightly inside the main window rather than in a screen corner
        self.geometry(f"540x420+{parent.winfo_rootx() + 60}+{parent.winfo_rooty() + 60}")
        self.transient(parent)
        self.all_jokes = list(jokes)
        self.visible = []          # the jokes currently listed (after filtering)
        self.on_show = on_show
        self.on_remove = on_remove
        self.query = tk.StringVar()

        if searchable:
            makeLabel(self, "Search setups and punchlines:", 12, INK).pack(
                anchor="w", padx=14, pady=(12, 2))
            self.query.trace_add("write", lambda *args: self.refresh())
            entry = tk.Entry(self, textvariable=self.query, font=(FONT, 13),
                             relief="flat", highlightthickness=2,
                             highlightbackground=GOLD_BORDER, highlightcolor=PUNCHLINE)
            entry.pack(fill="x", padx=14, ipady=3)
            entry.focus()

        # The button row and status line are packed first, at the bottom, so the
        # list shrinks to fit instead of pushing them out of the window.
        buttons = tk.Frame(self, bg=SPOTLIGHT)
        buttons.pack(side="bottom", pady=(4, 10))
        RoundedButton(buttons, "Show joke", self.showSelected, width=120, height=34,
                      radius=17, font_px=13).pack(side="left", padx=4)
        if on_remove:
            RoundedButton(buttons, "Remove", self.removeSelected, width=120, height=34,
                          radius=17, font_px=13, style="secondary").pack(side="left", padx=4)
        RoundedButton(buttons, "Close", self.destroy, width=120, height=34, radius=17,
                      font_px=13, style="secondary").pack(side="left", padx=4)

        self.status = makeLabel(self, "", 11, MUTED, anchor="w")
        self.status.pack(side="bottom", fill="x", padx=14)

        list_frame = tk.Frame(self, bg=SPOTLIGHT)
        list_frame.pack(fill="both", expand=True, padx=14, pady=10)
        self.listbox = tk.Listbox(list_frame, font=(FONT, 12), height=6, bg="#FFFBEF",
                                  fg=INK, selectbackground=GOLD, selectforeground=INK,
                                  activestyle="none", relief="flat",
                                  highlightthickness=1, highlightbackground=GOLD_BORDER)
        scrollbar = tk.Scrollbar(list_frame, command=self.listbox.yview)
        self.listbox.config(yscrollcommand=scrollbar.set)
        self.listbox.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        self.listbox.bind("<Double-Button-1>", lambda event: self.showSelected())

        self.refresh()
        self.wait_visibility()
        self.grab_set()  # modal: finish with this window first

    def refresh(self):
        """Re-fill the list using the current search text."""
        self.visible = searchJokes(self.all_jokes, self.query.get())
        self.listbox.delete(0, tk.END)
        for setup, _ in self.visible:
            self.listbox.insert(tk.END, setup)
        self.status.config(text=f"{len(self.visible)} joke(s)" if self.visible
                           else "No jokes to show.")

    def selected(self):
        """Return the highlighted joke, or None."""
        chosen = self.listbox.curselection()
        return self.visible[chosen[0]] if chosen else None

    def showSelected(self):
        joke = self.selected()
        if joke is None:
            messagebox.showinfo("Select a joke", "Click a joke in the list first.", parent=self)
            return
        self.destroy()
        self.on_show(joke)

    def removeSelected(self):
        joke = self.selected()
        if joke is None:
            messagebox.showinfo("Select a joke", "Click a joke in the list first.", parent=self)
            return
        try:
            self.on_remove(joke)
        except ValueError as error:
            messagebox.showerror("Could not remove", str(error), parent=self)
            return
        self.all_jokes.remove(joke)
        self.refresh()


class AddJokeDialog(tk.Toplevel):
    """A small form for adding a joke. on_save(setup, punchline) may raise
    ValueError to reject the joke; the message is shown in this dialog."""

    def __init__(self, parent, on_save):
        super().__init__(parent, bg=SPOTLIGHT)
        self.title("Add a joke")
        self.resizable(False, False)
        self.geometry(f"+{parent.winfo_rootx() + 80}+{parent.winfo_rooty() + 120}")
        self.transient(parent)
        self.on_save = on_save

        fields = []
        for label_text in ("Setup (ends with a question mark)", "Punchline"):
            makeLabel(self, label_text, 12, INK).pack(anchor="w", padx=16, pady=(12, 2))
            entry = tk.Entry(self, width=48, font=(FONT, 13), relief="flat",
                             highlightthickness=2, highlightbackground=GOLD_BORDER,
                             highlightcolor=PUNCHLINE)
            entry.pack(padx=16, ipady=3)
            fields.append(entry)
        self.setup_entry, self.punchline_entry = fields

        buttons = tk.Frame(self, bg=SPOTLIGHT)
        buttons.pack(pady=14)
        RoundedButton(buttons, "Save joke", self.submit, width=130, height=34,
                      radius=17, font_px=13).pack(side="left", padx=4)
        RoundedButton(buttons, "Cancel", self.destroy, width=130, height=34,
                      radius=17, font_px=13, style="secondary").pack(side="left", padx=4)

        self.bind("<Return>", lambda event: self.submit())
        self.setup_entry.focus()
        self.wait_visibility()
        self.grab_set()

    def submit(self):
        try:
            self.on_save(self.setup_entry.get(), self.punchline_entry.get())
        except ValueError as error:
            messagebox.showerror("Cannot add joke", str(error), parent=self)
            return
        self.destroy()


# GUI application 
class JokeApp:
    def __init__(self, root, jokes, jokes_path, favourites_path):
        self.root = root
        self.jokes = jokes
        self.jokes_path = jokes_path
        self.favourites_path = favourites_path
        self.deck = JokeDeck(jokes)                       # shuffled, no repeats per round
        self.favourites = loadFavourites(favourites_path)

        self.current = None           # the (setup, punchline) on screen
        self.punchline_shown = False
        self.busy = False             # True while the setup is being thought of and typed
        self.rated = False            # has the current joke been rated yet?
        self.funny = 0                # ratings given this session
        self.groan = 0
        self._job = None              # the single pending animation step, if any

        root.title("Alexa Joke Assistant")
        root.geometry("660x740")
        root.resizable(False, False)
        root.configure(bg=CURTAIN)

        self.buildLayout()
        self.bindKeys()
        self.refreshButtons()

    # --- Layout ---
    def buildLayout(self):
        makeLabel(self.root, "Alexa Joke Assistant", 20, GOLD, bold=True).pack(pady=(14, 6))
        self.top_lights = MarqueeLights(self.root)
        self.top_lights.pack()

        card = tk.Frame(self.root, bg=SPOTLIGHT, highlightthickness=2,
                        highlightbackground=GOLD_BORDER, highlightcolor=GOLD_BORDER,
                        padx=18, pady=10)
        card.pack(fill="x", padx=40, pady=6)

        self.counter_label = makeLabel(card, "", 11, MUTED, anchor="e")
        self.counter_label.pack(fill="x")
        # wraplength makes long jokes wrap instead of running off the window
        self.setup_label = makeLabel(card, "Click the button to hear a joke!", 16, INK,
                                     wraplength=540, height=3)
        self.setup_label.pack(pady=(2, 2))
        self.punchline_label = makeLabel(card, "", 16, PUNCHLINE, bold=True,
                                         wraplength=540, height=3)
        self.punchline_label.pack(pady=2)
        self.badum_label = makeLabel(card, "", 11, MUTED, italic=True)
        self.badum_label.pack()

        # The four buttons required by the brief
        main = tk.Frame(card, bg=SPOTLIGHT)
        main.pack(pady=(4, 0))
        self.tell_button = RoundedButton(main, "Alexa tell me a Joke", self.tellJoke, width=230)
        self.punchline_button = RoundedButton(main, "Show Punchline", self.showPunchline, width=230)
        self.next_button = RoundedButton(main, "Next Joke", self.tellJoke, width=230)
        self.quit_button = RoundedButton(main, "Quit", self.root.destroy, width=230,
                                         style="secondary")
        self.tell_button.grid(row=0, column=0)
        self.punchline_button.grid(row=0, column=1)
        self.next_button.grid(row=1, column=0)
        self.quit_button.grid(row=1, column=1)

        # Favourite and rating buttons for the joke on screen
        small = {"width": 120, "height": 34, "radius": 17, "font_px": 13}
        actions = tk.Frame(card, bg=SPOTLIGHT)
        actions.pack()
        self.favourite_button = RoundedButton(actions, "Favourite", self.addFavourite, **small)
        self.funny_button = RoundedButton(actions, "Funny", lambda: self.rate("funny"), **small)
        self.groan_button = RoundedButton(actions, "Groan", lambda: self.rate("groan"), **small)
        for button in (self.favourite_button, self.funny_button, self.groan_button):
            button.pack(side="left", padx=4)
        self.stats_label = makeLabel(card, "Rated so far: 0 funny, 0 groan", 11, MUTED)
        self.stats_label.pack()

        # Tools that open pop-up windows
        tools = tk.Frame(card, bg=SPOTLIGHT)
        tools.pack()
        RoundedButton(tools, "Search", self.openSearch, style="secondary", **small).pack(side="left", padx=4)
        RoundedButton(tools, "Add joke", self.openAddJoke, style="secondary", **small).pack(side="left", padx=4)
        RoundedButton(tools, "Favourites", self.openFavourites, style="secondary", **small).pack(side="left", padx=4)

        makeLabel(card, "Space: reveal / next joke     F: favourite     Esc: quit",
                  11, MUTED).pack(pady=(2, 0))

        self.bottom_lights = MarqueeLights(self.root)
        self.bottom_lights.pack(pady=(4, 0))

    #  Animation helpers 
    # Only one animation step is ever pending, so any new action can stop
    # whatever is running with cancelAnimation().
    def later(self, delay_ms, function):
        """Run `function` after a delay, remembering it so it can be cancelled."""
        self._job = self.root.after(delay_ms, function)

    def cancelAnimation(self):
        if self._job is not None:
            self.root.after_cancel(self._job)
            self._job = None

    def thinking(self, label, then, frames=THINK_FRAMES, frame=0):
        """Show 1, 2, 3 dots in `label` (like Alexa thinking), then call `then`."""
        if frame >= frames:
            self._job = None
            then()
            return
        label.config(text="." * (frame % 3 + 1))
        self.later(THINK_MS, lambda: self.thinking(label, then, frames, frame + 1))

    def typeText(self, label, text, done=None, index=0):
        """Reveal `text` one letter at a time (typewriter effect)."""
        label.config(text=text[:index])
        if index < len(text):
            self.later(TYPE_MS, lambda: self.typeText(label, text, done, index + 1))
        else:
            self._job = None
            if done:
                done()

    def flashPunchline(self, count=0):
        """Flash the punchline between two colours, then show 'Ba-dum-tss!'."""
        if count >= FLASH_COUNT:
            self.punchline_label.config(fg=PUNCHLINE)
            self.badum_label.config(text="Ba-dum-tss!")
            self._job = None
            return
        self.punchline_label.config(fg=FLASH if count % 2 == 0 else PUNCHLINE)
        self.later(FLASH_MS, lambda: self.flashPunchline(count + 1))

    def setLightsFast(self, fast):
        self.top_lights.setFast(fast)
        self.bottom_lights.setFast(fast)

    #  Keyboard shortcuts 
    def bindKeys(self):
        self.root.bind("<space>", self.onSpace)
        self.root.bind("<Escape>", lambda event: self.root.destroy())
        self.root.bind("<f>", lambda event: self.addFavourite())
        self.root.bind("<F>", lambda event: self.addFavourite())

    def onSpace(self, event=None):
        """Space does the obvious next thing: tell a joke, then reveal the
        punchline, then move on to the next joke."""
        if self.busy:
            return
        if self.current is None or self.punchline_shown:
            self.tellJoke()
        else:
            self.showPunchline()

    #  Button state: one place decides what is enabled 
    def refreshButtons(self):
        """Enable only the buttons that make sense right now."""
        ready = self.current is not None and not self.busy
        saved = ready and self.current in self.favourites

        def enable(button, on):
            button.config(state="normal" if on else "disabled")

        enable(self.punchline_button, ready and not self.punchline_shown)
        enable(self.next_button, ready)
        enable(self.favourite_button, ready and not saved)
        self.favourite_button.config(text="Saved" if saved else "Favourite")
        enable(self.funny_button, ready and not self.rated)
        enable(self.groan_button, ready and not self.rated)

    #  Telling jokes 
    def tellJoke(self):
        """Deal the next joke from the shuffled deck."""
        joke = self.deck.draw()
        self.showJoke(joke, f"Joke {self.deck.position} of {self.deck.total}")

    def showJoke(self, joke, counter_text):
        """Show a joke's setup with the thinking-dots and typewriter effects."""
        self.cancelAnimation()
        self.current = joke
        self.punchline_shown = False
        self.rated = False
        self.busy = True
        self.counter_label.config(text=counter_text)
        self.setup_label.config(text="")
        self.punchline_label.config(text="", fg=PUNCHLINE)
        self.badum_label.config(text="")
        self.refreshButtons()
        self.setLightsFast(True)
        self.thinking(self.setup_label,
                      lambda: self.typeText(self.setup_label, joke[0], self.setupDone))

    def setupDone(self):
        self.busy = False
        self.setLightsFast(False)
        self.refreshButtons()

    def showPunchline(self):
        """Reveal the punchline below the setup."""
        if self.current is None or self.punchline_shown or self.busy:
            return
        self.punchline_shown = True
        self.refreshButtons()
        self.thinking(self.punchline_label,
                      lambda: self.typeText(self.punchline_label, self.current[1],
                                            self.flashPunchline),
                      frames=3)

    #  Favourites and ratings 
    def addFavourite(self):
        """Save the joke on screen to favourites.txt."""
        if self.current is None or self.busy or self.current in self.favourites:
            return
        updated = self.favourites + [self.current]
        try:
            saveJokes(self.favourites_path, updated)
        except OSError as error:
            messagebox.showerror("Could not save", f"Favourite not saved:\n{error}")
            return
        self.favourites = updated
        self.refreshButtons()

    def removeFavourite(self, joke):
        """Used by the Favourites window. Raises ValueError if it can't save."""
        updated = [fav for fav in self.favourites if fav != joke]
        try:
            saveJokes(self.favourites_path, updated)
        except OSError as error:
            raise ValueError(f"Favourites could not be saved:\n{error}") from error
        self.favourites = updated
        self.refreshButtons()

    def rate(self, kind):
        """Record a funny / groan rating for the joke on screen (once each)."""
        if self.current is None or self.busy or self.rated:
            return
        if kind == "funny":
            self.funny += 1
        else:
            self.groan += 1
        self.rated = True
        self.stats_label.config(
            text=f"Rated so far: {self.funny} funny, {self.groan} groan")
        self.refreshButtons()

    #  Pop-up windows 
    def openSearch(self):
        JokeListDialog(self.root, "Search jokes", self.jokes,
                       lambda joke: self.showJoke(joke, "Search result"),
                       searchable=True)

    def openFavourites(self):
        JokeListDialog(self.root, "Favourite jokes", self.favourites,
                       lambda joke: self.showJoke(joke, "From favourites"),
                       on_remove=self.removeFavourite)

    def openAddJoke(self):
        AddJokeDialog(self.root, self.saveNewJoke)

    def saveNewJoke(self, setup, punchline):
        """Validate a new joke, save it to the jokes file and add it to the deck.
        Raises ValueError (shown in the dialog) if it can't be added."""
        joke = validateNewJoke(setup, punchline, self.jokes)
        try:
            appendLine(self.jokes_path, joke[0] + joke[1])
        except OSError as error:
            raise ValueError(f"The joke could not be saved:\n{error}") from error
        self.jokes.append(joke)
        self.deck.add(joke)
        messagebox.showinfo("Joke added", "Saved to the jokes file and added to the deck.",
                            parent=self.root)


def main():
    root = tk.Tk()
    root.withdraw()  # stay hidden until the jokes are loaded
    path = findJokesFile()
    if path is None:
        messagebox.showinfo("Jokes file not found",
                            f"Could not find {JOKES_FILE}.\nChoose it in the next window.")
        path = filedialog.askopenfilename(
            title=f"Select {JOKES_FILE}",
            filetypes=[("Text files", "*.txt"), ("All files", "*.*")])
        if not path:
            root.destroy()
            return

    try:
        jokes = loadJokes(path)
    except (OSError, UnicodeDecodeError) as error:
        messagebox.showerror("Could not read file", str(error))
        root.destroy()
        return
    if not jokes:
        messagebox.showerror("No jokes", f"{path} contains no valid jokes.")
        root.destroy()
        return

    JokeApp(root, jokes, path, os.path.join(SCRIPT_DIR, FAVOURITES_FILE))
    root.deiconify()
    root.mainloop()


if __name__ == "__main__":
    main()
