"""
Exercise 1 - Maths Quiz (Tkinter)

A 10-question arithmetic quiz with three difficulty levels.
Scoring: 10 points for a correct first attempt, 5 for a correct second
attempt, 0 if both attempts are wrong (maximum score = 100).

Styling: dark "Midnight amber" theme with custom rounded buttons that zoom in
smoothly when the mouse hovers over them. A Back button lets the player
return to the difficulty menu mid-quiz.
"""

import math
import random
import tkinter as tk
from tkinter import messagebox

#  Quiz constants 
NUM_QUESTIONS = 10
POINTS_FIRST_TRY = 10
POINTS_SECOND_TRY = 5

# Difficulty level -> (name, min, max) value for the numbers in each question
LEVELS = {
    1: ("Easy", 0, 9),            # single digit
    2: ("Moderate", 10, 99),      # double digit
    3: ("Advanced", 1000, 9999),  # four digit
}

# The menu buttons widen with difficulty so the stack forms a triangle
# (narrow Easy at the top, wide Advanced at the bottom).
MENU_MIN_WIDTH = 150   # width of the Easy button
MENU_WIDTH_STEP = 80   # extra width for each step up in difficulty

# Theme colours: Midnight amber (dark charcoal + golden accent) 
BG = "#17171C"            # window background
CARD = "#24242D"          # panel the content sits on
BORDER = "#363642"        # soft outline
ACCENT = "#E3A857"        # golden amber for primary buttons
ACCENT_HOVER = "#F0BA6E"  # lighter amber when hovered
HOVER_LIGHT = "#2F2F3A"   # secondary button hover fill
BUTTON_TEXT = "#1B1B20"   # dark text on amber buttons (white would be unreadable)
TEXT = "#F3EFE7"          # warm off-white text
MUTED = "#A3A3B0"         # secondary text
ENTRY_BG = "#1B1B22"      # answer box
ENTRY_DISABLED_BG = "#2C2C36"
GOOD = "#7FC88A"          # correct answer (light green, readable on dark)
BAD = "#F08A7E"           # wrong answer
WARN = "#F0C060"          # invalid input
DISABLED_FILL = "#30303A"
DISABLED_TEXT = "#6E6E7C"
FONT = "Helvetica"


#  Pure logic functions 
def randomInt(level):
    """Return a random integer whose size depends on the difficulty level."""
    _, low, high = LEVELS[level]
    return random.randint(low, high)


def decideOperation():
    """Randomly choose addition or subtraction and return '+' or '-'."""
    return random.choice(["+", "-"])


def isCorrect(user_answer, correct_answer):
    """Return True if the user's answer matches the correct answer."""
    return user_answer == correct_answer


def getRank(score):
    """Convert a score out of 100 into a letter rank."""
    if score > 90:
        return "A+"
    if score >= 80:
        return "A"
    if score >= 70:
        return "B"
    if score >= 60:
        return "C"
    if score >= 50:
        return "D"
    return "F"


#  Custom widget: rounded button with hover zoom 
class RoundedButton(tk.Canvas):
    """A button with rounded corners that smoothly zooms in on hover.

    Standard Tkinter buttons cannot be rounded or animated, so this draws
    the button on a Canvas. The canvas is a little bigger than the button
    so there is room for it to grow without being clipped.

    style="primary"   -> solid brown button with white text
    style="secondary" -> white button with a brown outline
    """
    ZOOM = 1.08       # how much bigger the button gets on hover
    PRESSED = 0.97    # slight shrink while the mouse button is held down
    EASING = 0.25     # fraction of the remaining distance moved per frame
    FRAME_MS = 16     # about 60 frames per second

    STYLES = {
        "primary": {"fill": ACCENT, "hover": ACCENT_HOVER,
                    "text": BUTTON_TEXT, "outline": ACCENT},
        "secondary": {"fill": CARD, "hover": HOVER_LIGHT,
                      "text": TEXT, "outline": ACCENT},
    }

    def __init__(self, master, text, command, width=220, height=44,
                 radius=22, style="primary", font_px=16):
        pad = int(width * (self.ZOOM - 1) / 2) + 4  # headroom for the zoom
        self._cw = width + 2 * pad                  # canvas width
        self._ch = height + 2 * pad                 # canvas height
        super().__init__(master, width=self._cw, height=self._ch,
                         bg=master.cget("bg"), highlightthickness=0, bd=0)

        self._text = text
        self._command = command
        self._btn_w, self._btn_h = width, height
        self._radius = radius
        self._font_px = font_px
        self._colors = self.STYLES[style]

        self._state = "normal"
        self._hover = False
        self._pressed = False
        self._scale = 1.0      # current size multiplier
        self._job = None       # id of the pending animation frame

        self.bind("<Enter>", self._onEnter)
        self.bind("<Leave>", self._onLeave)
        self.bind("<ButtonPress-1>", self._onPress)
        self.bind("<ButtonRelease-1>", self._onRelease)
        self._draw()

    # drawing 
    def _roundRect(self, x0, y0, x1, y1, r, **options):
        """Draw a rounded rectangle as a polygon whose corners are quarter
        circles (10 points per corner), giving a properly round radius."""
        r = min(r, (x1 - x0) / 2, (y1 - y0) / 2)  # can't be rounder than a pill
        corners = [(x1 - r, y0 + r, -90), (x1 - r, y1 - r, 0),
                   (x0 + r, y1 - r, 90), (x0 + r, y0 + r, 180)]
        points = []
        for centre_x, centre_y, start_angle in corners:
            for step in range(10):
                angle = math.radians(start_angle + step * 10)
                points.append(centre_x + r * math.cos(angle))
                points.append(centre_y + r * math.sin(angle))
        return self.create_polygon(points, **options)

    def _draw(self):
        self.delete("all")
        s = self._scale
        w, h, r = self._btn_w * s, self._btn_h * s, self._radius * s
        x0, y0 = (self._cw - w) / 2, (self._ch - h) / 2

        if self._state == "disabled":
            fill, outline, text_color = DISABLED_FILL, DISABLED_FILL, DISABLED_TEXT
        else:
            fill = self._colors["hover"] if self._hover else self._colors["fill"]
            outline, text_color = self._colors["outline"], self._colors["text"]

        self._roundRect(x0, y0, x0 + w, y0 + h, r, fill=fill, outline=outline, width=2)
        # Negative font size = pixels, which scales smoothly during the zoom
        self.create_text(self._cw / 2, self._ch / 2, text=self._text, fill=text_color,
                         font=(FONT, -round(self._font_px * s), "bold"))

    #  animation 
    def _target(self):
        """The size the button is currently trying to reach."""
        if self._state == "disabled":
            return 1.0
        if self._pressed:
            return self.PRESSED
        return self.ZOOM if self._hover else 1.0

    def _animate(self):
        """Start (or restart) moving towards the target size."""
        if self._job is not None:
            self.after_cancel(self._job)
            self._job = None
        self._step()

    def _step(self):
        """One animation frame: move part of the way to the target (easing)."""
        self._job = None
        try:
            target = self._target()
            difference = target - self._scale
            if abs(difference) < 0.002:
                self._scale = target
                self._draw()
                return
            self._scale += difference * self.EASING
            self._draw()
            self._job = self.after(self.FRAME_MS, self._step)
        except tk.TclError:
            pass  # the widget was destroyed mid-animation

    #  mouse events 
    def _onEnter(self, event):
        self._hover = True
        self.config(cursor="arrow" if self._state == "disabled" else "hand2")
        self._animate()

    def _onLeave(self, event):
        self._hover = False
        self._pressed = False
        self._animate()

    def _onPress(self, event):
        if self._state != "disabled":
            self._pressed = True
            self._animate()

    def _onRelease(self, event):
        if not self._pressed:
            return
        self._pressed = False
        self._animate()
        # Only count it as a click if the mouse is still over the button
        inside = 0 <= event.x <= self._cw and 0 <= event.y <= self._ch
        if inside:
            self.invoke()

    #  public API (mirrors tk.Button where it matters) 
    def invoke(self):
        """Run the button's command, as if it had been clicked."""
        if self._state != "disabled" and self._command:
            self._command()

    def config(self, **options):
        """Support config(state=...) and config(text=...) like a tk.Button."""
        if "state" in options:
            self._state = options.pop("state")
            self._animate()
        if "text" in options:
            self._text = options.pop("text")
            self._draw()
        if options:
            super().config(**options)

    configure = config

    def destroy(self):
        if self._job is not None:
            try:
                self.after_cancel(self._job)
            except tk.TclError:
                pass
            self._job = None
        super().destroy()


# GUI application 
class MathsQuiz:
    def __init__(self, root):
        self.root = root
        self.root.title("Maths Quiz")
        self.root.geometry("480x520")
        self.root.resizable(False, False)
        self.root.configure(bg=BG)

        # Quiz state
        self.level = 1
        self.score = 0
        self.question_number = 0
        self.attempt = 1
        self.num1 = 0
        self.num2 = 0
        self.operation = "+"
        self.answer = 0
        self.pending_job = None  # scheduled "next question", if any

        # A white card on the beige window. Every screen is built inside it
        # and clearScreen() empties it between screens.
        self.frame = tk.Frame(self.root, bg=CARD, padx=24, pady=18,
                              highlightthickness=1, highlightbackground=BORDER,
                              highlightcolor=BORDER)
        self.frame.pack(fill="both", expand=True, padx=22, pady=22)

        self.displayMenu()

    #  helpers 
    def clearScreen(self):
        """Remove every widget from the current screen."""
        for widget in self.frame.winfo_children():
            widget.destroy()

    def schedule(self, delay_ms, function):
        """Run `function` after a delay, remembering it so it can be cancelled."""
        self.pending_job = self.root.after(delay_ms, function)

    def cancelPending(self):
        """Cancel a scheduled next-question so it can't fire after leaving
        the quiz (e.g. when the Back button is pressed during the pause)."""
        if self.pending_job is not None:
            self.root.after_cancel(self.pending_job)
            self.pending_job = None

    def label(self, text, size, bold=False, color=TEXT, **options):
        """Create a themed label inside the card."""
        weight = "bold" if bold else "normal"
        return tk.Label(self.frame, text=text, bg=CARD, fg=color,
                        font=(FONT, size, weight), **options)

    #  Screen 1: difficulty menu 
    def displayMenu(self):
        """Show the difficulty level menu at the start of each quiz."""
        self.cancelPending()
        self.clearScreen()
        self.label("Maths Quiz", 11, color=MUTED).pack(pady=(25, 0))
        self.label("DIFFICULTY LEVEL", 20, bold=True).pack(pady=(2, 25))

        # Each level is wider than the last, so the buttons form a triangle
        # (pack() centres them, giving a symmetrical pyramid shape).
        for number, (name, _, _) in LEVELS.items():
            width = MENU_MIN_WIDTH + (number - 1) * MENU_WIDTH_STEP
            RoundedButton(self.frame, f"{number}. {name}",
                          lambda n=number: self.startQuiz(n),
                          width=width).pack(pady=4)

    def startQuiz(self, level):
        """Reset the state for a new game at the chosen level."""
        self.level = level
        self.score = 0
        self.question_number = 0
        self.nextQuestion()

    #  Screen 2: question 
    def nextQuestion(self):
        """Generate a new question, or finish if all 10 have been asked."""
        self.pending_job = None
        if self.question_number >= NUM_QUESTIONS:
            self.displayResults()
            return

        self.question_number += 1
        self.attempt = 1
        self.num1 = randomInt(self.level)
        self.num2 = randomInt(self.level)
        self.operation = decideOperation()
        self.answer = (self.num1 + self.num2 if self.operation == "+"
                       else self.num1 - self.num2)
        self.displayProblem()

    def displayProblem(self):
        """Show the question and an entry box for the user's answer."""
        self.clearScreen()

        # Back button, top left
        top = tk.Frame(self.frame, bg=CARD)
        top.pack(fill="x")
        RoundedButton(top, "\u2190 Back", self.backToMenu, width=100,
                      height=34, radius=17, style="secondary",
                      font_px=14).pack(side="left")

        self.label(f"Question {self.question_number} of {NUM_QUESTIONS}"
                   f"   \u2022   Score: {self.score}", 12,
                   color=MUTED).pack(pady=(10, 8))

        self.label(f"{self.num1} {self.operation} {self.num2} =", 30,
                   bold=True).pack(pady=8)

        self.entry = tk.Entry(self.frame, font=(FONT, 18), width=10,
                              justify="center", bg=ENTRY_BG, fg=TEXT,
                              relief="flat", highlightthickness=2,
                              highlightbackground=BORDER,
                              highlightcolor=ACCENT, insertbackground=TEXT,
                              disabledbackground=ENTRY_DISABLED_BG,
                              disabledforeground=TEXT)
        self.entry.pack(pady=10, ipady=4)
        self.entry.focus()
        self.entry.bind("<Return>", lambda event: self.checkAnswer())

        self.feedback = self.label("", 12)
        self.feedback.pack(pady=4)

        self.submit_button = RoundedButton(self.frame, "Submit",
                                           self.checkAnswer, width=160)
        self.submit_button.pack(pady=4)

    def backToMenu(self):
        """Leave the quiz and return to the difficulty menu (after confirming,
        because the current score would be lost)."""
        if messagebox.askyesno("Back to menu",
                               "Go back to the difficulty menu?\n"
                               "Your progress in this quiz will be lost.",
                               parent=self.root):
            self.displayMenu()  # displayMenu also cancels any pending timer

    def checkAnswer(self):
        """Read the answer, mark it, and move on or allow a second attempt."""
        text = self.entry.get().strip()
        try:
            user_answer = int(text)
        except ValueError:
            # Invalid input should not use up an attempt
            self.feedback.config(text="Please enter a whole number.", fg=WARN)
            return

        if isCorrect(user_answer, self.answer):
            points = POINTS_FIRST_TRY if self.attempt == 1 else POINTS_SECOND_TRY
            self.score += points
            self.feedback.config(text=f"Correct! +{points} points", fg=GOOD)
            self.lockInput()
            self.schedule(900, self.nextQuestion)
        elif self.attempt == 1:
            self.attempt = 2
            self.feedback.config(text="Wrong - you have one more try!", fg=BAD)
            self.entry.delete(0, tk.END)
        else:
            self.feedback.config(
                text=f"Wrong. The answer was {self.answer}.", fg=BAD)
            self.lockInput()
            self.schedule(1500, self.nextQuestion)

    def lockInput(self):
        """Stop double-submissions while we wait to show the next question."""
        self.entry.config(state="disabled")
        self.entry.unbind("<Return>")
        self.submit_button.config(state="disabled")

    #  Screen 3: results 
    def displayResults(self):
        """Show the final score out of 100, the rank, and a replay option."""
        self.clearScreen()
        rank = getRank(self.score)

        self.label("Quiz Complete!", 22, bold=True).pack(pady=(30, 15))
        self.label(f"Score: {self.score} / 100", 17).pack(pady=5)
        self.label(f"Rank: {rank}", 28, bold=True, color=ACCENT).pack(pady=5)

        self.label("Would you like to play again?", 12,
                   color=MUTED).pack(pady=(22, 6))
        RoundedButton(self.frame, "Play Again", self.displayMenu,
                      width=180).pack(pady=3)
        RoundedButton(self.frame, "Quit", self.root.destroy, width=180,
                      style="secondary").pack(pady=3)


def main():
    root = tk.Tk()
    MathsQuiz(root)
    root.mainloop()


if __name__ == "__main__":
    main()